{
  "expo": {
    "name": "FixLens",
    "slug": "fixlens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fixlens",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fixlens.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.fixlens.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "FixLens uses your camera to photograph household problems.",
          "photosPermission": "Choose a household problem photo to assess and track.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Choose a household problem photo to assess and track.",
          "savePhotosPermission": "FixLens saves the problem photo and segmentation mask only when you choose Save to device.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
